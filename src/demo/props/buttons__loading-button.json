[{"component":"LoadingButton","extends":["Omit<HTMLMotionProps<\"button\">, \"children\" | \"onClick\">"],"props":[{"name":"children","type":"ReactNode","required":true,"default":null,"description":"Label shown while idle."},{"name":"loadingLabel","type":"ReactNode","required":false,"default":"\"Saving\"","description":"Label shown while loading."},{"name":"successLabel","type":"ReactNode","required":false,"default":"\"Saved\"","description":"Label shown after success."},{"name":"errorLabel","type":"ReactNode","required":false,"default":"\"Failed\"","description":"Label shown after an error."},{"name":"status","type":"LoadingStatus","required":false,"default":null,"description":"Controlled status. Leave it out to let a returned Promise drive it."},{"name":"onClick","type":"(e: MouseEvent<HTMLButtonElement>) => void | Promise<unknown>","required":false,"default":null,"description":"Called on click. If it returns a Promise, the button tracks it as loading, success or error."},{"name":"resetAfter","type":"number","required":false,"default":"1800","description":"Milliseconds before success or error returns to idle."}]}]