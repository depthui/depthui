[{"component":"Knob3D","extends":[],"props":[{"name":"value","type":"number","required":false,"default":null,"description":"Current value when controlled."},{"name":"defaultValue","type":"number","required":false,"default":"40","description":"Starting value when uncontrolled."},{"name":"onChange","type":"(value: number) => void","required":false,"default":null,"description":"Called with the new value whenever it changes."},{"name":"min","type":"number","required":false,"default":"0","description":"Lowest allowed value."},{"name":"max","type":"number","required":false,"default":"100","description":"Highest allowed value."},{"name":"step","type":"number","required":false,"default":"1","description":"Amount the value snaps to and changes by per key press."},{"name":"label","type":"string","required":true,"default":null,"description":"Accessible name for the knob."},{"name":"size","type":"number","required":false,"default":"150","description":"Diameter in px."},{"name":"showValue","type":"boolean","required":false,"default":"true","description":"Show the number inside the knob."},{"name":"className","type":"string","required":false,"default":null,"description":"Extra classes added to the outer element."}]}]